# Copy to .env.local and fill. .env.local is gitignored.
# In production these live in GitHub Actions secrets only — never in a committed
# file, never in vercel.json.
#
# Anything without a default here fails loudly at startup when a stage needs it.

# --- Anthropic ---
ANTHROPIC_API_KEY=

# --- Supabase ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=     # worker only; bypasses RLS, never client-side

# --- Commercial — NEVER commit real values, public repo ---
RATE_FLOOR_HOURLY_USD=
RATE_FLOOR_MONTHLY_USD=
SCORE_THRESHOLD=

# --- Sender 1: applications (Gmail, owner's real address) ---
# GMAIL_USER must be the exact account the app password was created under. The
# password authenticates one account only; a mismatch returns SMTP 535 and looks
# for all the world like a wrong password.
GMAIL_USER=
GMAIL_APP_PASSWORD=

# --- Sender 2: outreach (Zoho Mail Lite, separate warmed domain) ---
# Mail Lite, not the free tier — the free tier blocks SMTP and IMAP.
ZOHO_SMTP_HOST=smtp.zoho.com
ZOHO_SMTP_PORT=465
ZOHO_SMTP_USER=
ZOHO_SMTP_PASSWORD=
ZOHO_IMAP_HOST=imap.zoho.com
OUTREACH_DOMAIN=

# --- Sender 3: system alerts (ZeptoMail) ---
ZEPTOMAIL_TOKEN=
ZEPTOMAIL_FROM=

# --- Ops ---
DRY_RUN=true
DAILY_SEND_CAP=10

# --- Dashboard (step 8, Vercel env vars — server-side only) ---
# No NEXT_PUBLIC_* Supabase vars: RLS is forced with no policies, so the anon key
# grants nothing and the dashboard queries server-side with the service role.
