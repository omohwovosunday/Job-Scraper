# Copy to .env.local and fill. .env.local is gitignored.
# In production these live in GitHub Actions secrets only.

SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

ANTHROPIC_API_KEY=

# Commercial figures. No committed defaults by design — the worker
# fails at startup if these are unset. See CLAUDE-CODE-INSTRUCTIONS.md 2.3.
RATE_FLOOR_HOURLY_USD=
RATE_FLOOR_MONTHLY_USD=
SCORE_THRESHOLD=

# --- Not needed until step 9 (first live sends) ---
RESEND_API_KEY=
SENDING_DOMAIN=
APPLICATION_FROM_ADDRESS=
NOTIFY_EMAIL=

# --- Dashboard (step 8, Vercel env vars) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
